# Copie para .env se precisar alterar os padrões (que já batem com o docker-compose.yml)
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=mind
DB_PASSWORD=mind
DB_NAME=mind
# JWT: obrigatório em produção (NODE_ENV=production); fora dela há um segredo de desenvolvimento
JWT_SECRET=
JWT_EXPIRES_IN=8h
